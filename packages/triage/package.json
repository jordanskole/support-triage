{
  "name": "@support-triage/triage",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests --exclude 'src/**/*.db.test.ts'",
    "test:watch": "vitest --exclude 'src/**/*.db.test.ts'",
    "test:db": "turbo run build --filter=@support-triage/db --output-logs=errors-only && node ../db/scripts/with-test-db.mjs npm run db:deploy -w @support-triage/db && node ../db/scripts/with-test-db.mjs vitest run .db.test.ts",
    "backfill": "node dist/cli/backfill.js",
    "cli": "node dist/cli/triage.js",
    "eval": "node dist/cli/eval.js"
  },
  "dependencies": {
    "@support-triage/db": "*",
    "@anthropic-ai/sdk": "~1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
