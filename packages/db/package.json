{
  "name": "@support-triage/db",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./limits": {
      "types": "./dist/limits.d.ts",
      "default": "./dist/limits.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests --exclude 'src/**/*.db.test.ts'",
    "test:watch": "vitest --exclude 'src/**/*.db.test.ts'",
    "test:db": "prisma generate && node scripts/with-test-db.mjs prisma migrate deploy && node scripts/with-test-db.mjs vitest run .db.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run build && prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "~7.10.1",
    "typescript": "^7.0.2"
  }
}
