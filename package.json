{
  "name": "ac-1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "triage:backfill": "turbo run build --filter=@ac-1/triage --output-logs=errors-only && npm run backfill -w @ac-1/triage --"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
