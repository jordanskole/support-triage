{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".output/**",
        "dist/**",
        "src/generated/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prisma/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "src/**",
        "app/**",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "ANTHROPIC_API_KEY",
    "VOYAGE_API_KEY"
  ]
}
